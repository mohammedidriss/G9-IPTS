# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
*.pyc
*.log

# ── Virtual Environment ───────────────────────────────────────
venv/
env/
.env
.venv/

# ── Database (live data — never commit) ───────────────────────
*.db
*.sqlite3

# ── ML Models (large binaries — regenerate with train_on_real_data.py) ──
models/*.pkl
models/*.joblib
models/*.h5

# ── Dataset (144MB — downloaded on first run) ─────────────────
datasets/

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log

# ── Runtime directory (local execution only — all source mirrored to root) ──
.runtime/

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Node ──────────────────────────────────────────────────────
node_modules/
package-lock.json

# ── Secrets / Certs ───────────────────────────────────────────
*.pem
*.key
credentials.json

# ── Jupyter ───────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Claude local session ──────────────────────────────────────
.claude/

# ── Docs generation scripts ───────────────────────────────────
docs/generate_report.js
